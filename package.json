    "fflate": "0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.529",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
