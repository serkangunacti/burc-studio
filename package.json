{
  "name": "burc-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate:prod": "node --env-file=.env.production.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "generate:local": "node --env-file=.env.production.local --import tsx scripts/generate-local.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
